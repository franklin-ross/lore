{
    "name": "lore",
    "displayName": "Lore — TTRPG Knowledge Base",
    "description": "Entity definitions, cross-references, and semantic highlighting for TTRPG campaign notes",
    "version": "2.5.2",
    "publisher": "franklinross",
    "license": "Unlicense",
    "repository": {
        "type": "git",
        "url": "https://github.com/franklin-ross/lore.git"
    },
    "homepage": "https://github.com/franklin-ross/lore#readme",
    "bugs": {
        "url": "https://github.com/franklin-ross/lore/issues"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "ttrpg",
        "rpg",
        "lore",
        "notes",
        "knowledge-base",
        "markdown"
    ],
    "activationEvents": [
        "workspaceContains:lore.toml",
        "workspaceContains:**/lore.toml",
        "onWebviewPanel:loreWiki",
        "onWebviewPanel:loreGraph"
    ],
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run bundle",
        "bundle:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --minify",
        "bundle:webview": "esbuild media/wiki/main.ts --bundle --outfile=out/wiki/main.js --format=esm --platform=browser --sourcemap --minify",
        "bundle:graph": "esbuild media/graph/main.ts --bundle --splitting --outdir=out/graph --format=esm --platform=browser --sourcemap --minify",
        "bundle:css": "node -e \"const fs=require('node:fs');fs.mkdirSync('out/wiki',{recursive:true});fs.mkdirSync('out/graph',{recursive:true});fs.copyFileSync('media/wiki/wiki.css','out/wiki/wiki.css');fs.copyFileSync('media/graph/graph.css','out/graph/graph.css');fs.copyFileSync('media/shared/graph-render.css','out/wiki/graph-render.css');fs.copyFileSync('media/shared/graph-render.css','out/graph/graph-render.css')\"",
        "bundle": "npm run bundle:ext && npm run bundle:webview && npm run bundle:graph && npm run bundle:css",
        "watch:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
        "watch:webview": "esbuild media/wiki/main.ts --bundle --outfile=out/wiki/main.js --format=esm --platform=browser --sourcemap --watch",
        "watch:graph": "esbuild media/graph/main.ts --bundle --splitting --outdir=out/graph --format=esm --platform=browser --sourcemap --watch",
        "typecheck": "tsgo --noEmit",
        "test": "node --test --experimental-strip-types test/**/*.test.ts"
    },
    "dependencies": {
        "d3-force": "^3.0.0",
        "graphology": "^0.26.0",
        "graphology-layout-forceatlas2": "^0.10.1",
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/d3-force": "^3.0.10",
        "@types/node": "^25.6.0",
        "@types/vscode": "~1.85.0",
        "@typescript/native-preview": "^7.0.0-dev.20260421.2",
        "esbuild": "^0.28.1"
    },
    "contributes": {
        "languages": [
            {
                "id": "lore-state",
                "aliases": [
                    "Lore State"
                ]
            },
            {
                "id": "lore-relations",
                "aliases": [
                    "Lore Relations"
                ]
            }
        ],
        "grammars": [
            {
                "language": "lore-state",
                "scopeName": "source.lore-state",
                "path": "./syntaxes/lore-state.tmLanguage.json"
            },
            {
                "language": "lore-relations",
                "scopeName": "source.lore-relations",
                "path": "./syntaxes/lore-relations.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "lore.toggleHoverStateDirectives",
                "title": "Toggle Hover State Directives",
                "category": "Lore"
            },
            {
                "command": "lore.openWiki",
                "title": "Open Wiki",
                "category": "Lore",
                "icon": "$(book)"
            },
            {
                "command": "lore.openWikiAtCursor",
                "title": "Open Wiki at Cursor",
                "category": "Lore"
            },
            {
                "command": "lore.openGraph",
                "title": "Open Knowledge Graph",
                "category": "Lore",
                "icon": "$(graph)"
            }
        ],
        "keybindings": [
            {
                "command": "lore.openWikiAtCursor",
                "key": "f12",
                "when": "editorTextFocus && editorLangId == markdown && lore.inProject"
            }
        ],
        "configuration": {
            "title": "Lore",
            "properties": {
                "lore.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the lore binary. If empty, uses 'lore' from PATH."
                },
                "lore.hover.stateMode": {
                    "type": "string",
                    "enum": [
                        "both",
                        "atCursor",
                        "latest"
                    ],
                    "enumDescriptions": [
                        "Show the state at the cursor and the latest state when they differ.",
                        "Show only the state resolved up to the cursor position.",
                        "Show only the latest resolved state for the entity."
                    ],
                    "default": "both",
                    "description": "Which entity state blocks to show in the hover view."
                },
                "lore.hover.showStateDirectives": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show inline state directives (+tag, field = 100) inside description prose in the hover view. Disabled by default since the resolved state is already shown at the top."
                },
                "lore.definitionStyle": {
                    "type": "string",
                    "enum": [
                        "background",
                        "underline",
                        "none"
                    ],
                    "enumDescriptions": [
                        "Tint the definition span with a faded version of the palette colour.",
                        "Underline the definition span in the palette colour.",
                        "Do not visually distinguish definition spans from prose."
                    ],
                    "default": "background",
                    "description": "How to highlight the definition occurrence of an entity name (the name on its header line or inline aside) so it stands out from references in prose."
                },
                "lore.graph.arrowSize": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 20,
                    "description": "Size of arrowheads on knowledge-graph edges. Edge colour matches the source entity, so arrows are optional. 0 to disable."
                },
                "lore.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace communication between VSCode and the lore language server."
                }
            }
        },
        "semanticTokenTypes": [
            {
                "id": "loreEntity",
                "description": "A lore entity reference"
            }
        ],
        "semanticTokenModifiers": [
            {
                "id": "loreColourA",
                "description": "Entity colour A"
            },
            {
                "id": "loreColourB",
                "description": "Entity colour B"
            },
