{
    "name": "lore",
    "displayName": "Lore — TTRPG Knowledge Base",
    "description": "Entity definitions, cross-references, and semantic highlighting for TTRPG campaign notes",
    "version": "0.1.0",
    "publisher": "franklinross",
    "license": "MIT",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "workspaceContains:lore.toml",
        "workspaceContains:**/lore.toml"
    ],
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run bundle",
        "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "esbuild": "^0.28.0",
        "typescript": "^5.3.0"
    },
    "contributes": {
        "configuration": {
            "title": "Lore",
            "properties": {
                "lore.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the lore binary. If empty, uses 'lore' from PATH."
                },
                "lore.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace communication between VSCode and the lore language server."
                }
            }
        },
        "semanticTokenTypes": [
            {
                "id": "loreEntity",
                "description": "A lore entity reference"
            }
        ],
        "semanticTokenModifiers": [
            {
                "id": "loreColourA",
                "description": "Entity colour A"
            },
            {
                "id": "loreColourB",
                "description": "Entity colour B"
            },
            {
                "id": "loreColourC",
                "description": "Entity colour C"
            },
            {
                "id": "loreColourD",
                "description": "Entity colour D"
            },
            {
                "id": "loreColourE",
                "description": "Entity colour E"
            },
            {
                "id": "loreColourF",
                "description": "Entity colour F"
            },
            {
                "id": "loreColourG",
                "description": "Entity colour G"
            },
            {
                "id": "loreColourH",
                "description": "Entity colour H"
            },
            {
                "id": "loreColourI",
                "description": "Entity colour I"
            },
            {
                "id": "loreColourJ",
                "description": "Entity colour J"
            },
            {
                "id": "loreColourK",
                "description": "Entity colour K"
            },
            {
                "id": "loreColourL",
                "description": "Entity colour L"
            },
            {
                "id": "loreColourM",
                "description": "Entity colour M"
            },
            {
                "id": "loreColourN",
                "description": "Entity colour N"
            },
            {
                "id": "loreColourO",
                "description": "Entity colour O"
            },
            {
                "id": "loreColourP",
                "description": "Entity colour P"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "markdown",
                "scopes": {
                    "loreEntity": [
                        "entity.name.lore"
                    ]
                }
            }
        ],
        "configurationDefaults": {
            "editor.semanticTokenColorCustomizations": {
                "[*]": {
                    "rules": {
                        "loreEntity.loreColourA": {
                            "foreground": "#4EC9B0",
                            "bold": true
                        },
                        "loreEntity.loreColourB": {
                            "foreground": "#DCDCAA",
                            "bold": true
                        },
                        "loreEntity.loreColourC": {
                            "foreground": "#C586C0",
                            "bold": true
                        },
                        "loreEntity.loreColourD": {
                            "foreground": "#CE9178",
                            "bold": true
                        },
                        "loreEntity.loreColourE": {
                            "foreground": "#569CD6",
                            "bold": true
                        },
                        "loreEntity.loreColourF": {
                            "foreground": "#D7BA7D",
                            "bold": true
                        },
                        "loreEntity.loreColourG": {
                            "foreground": "#9CDCFE",
                            "bold": true
                        },
                        "loreEntity.loreColourH": {
                            "foreground": "#B5CEA8",
                            "bold": true
                        },
                        "loreEntity.loreColourI": {
                            "foreground": "#F48771",
                            "bold": true
                        },
                        "loreEntity.loreColourJ": {
                            "foreground": "#D4D4D4",
                            "bold": true
                        },
                        "loreEntity.loreColourK": {
                            "foreground": "#E8C87A",
                            "bold": true
                        },
                        "loreEntity.loreColourL": {
                            "foreground": "#A8D8B9",
                            "bold": true
                        },
                        "loreEntity.loreColourM": {
                            "foreground": "#D2A0D0",
                            "bold": true
                        },
                        "loreEntity.loreColourN": {
                            "foreground": "#8BBCE8",
                            "bold": true
                        },
                        "loreEntity.loreColourO": {
                            "foreground": "#E2B07A",
                            "bold": true
                        },
                        "loreEntity.loreColourP": {
                            "foreground": "#8FD4C4",
                            "bold": true
                        }
                    }
                }
            }
        }
    }
}
