            },
            {
                "id": "loreColourZ",
                "description": "Entity colour Z"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "markdown",
                "scopes": {
                    "loreEntity": [
                        "entity.name.lore"
                    ]
                }
            }
        ],
