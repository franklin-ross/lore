            },
            {
                "id": "loreColourY",
                "description": "Entity colour Y"
            },
            {
                "id": "loreColourZ",
                "description": "Entity colour Z"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "markdown",
                "scopes": {
                    "loreEntity": [
                        "entity.name.lore"
                    ],
                    "loreOperator": [
                        "keyword.operator.lore"
                    ],
                    "loreName": [
                        "variable.parameter.lore"
                    ],
                    "loreNumber": [
                        "constant.numeric.lore"
                    ],
                    "loreString": [
                        "string.unquoted.lore"
                    ],
                    "lorePunctuation": [
                        "punctuation.separator.lore"
                    ]
                }
            }
        ],
        "configurationDefaults": {
