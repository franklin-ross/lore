{
    "name": "lore",
    "displayName": "Lore — TTRPG Knowledge Base",
    "description": "Entity definitions, cross-references, and semantic highlighting for TTRPG campaign notes",
    "version": "0.10.0",
    "publisher": "franklinross",
    "license": "Unlicense",
    "repository": {
        "type": "git",
        "url": "https://github.com/franklin-ross/lore.git"
    },
    "homepage": "https://github.com/franklin-ross/lore#readme",
    "bugs": {
        "url": "https://github.com/franklin-ross/lore/issues"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "ttrpg",
        "rpg",
        "lore",
        "notes",
        "knowledge-base",
        "markdown"
    ],
    "activationEvents": [
        "workspaceContains:lore.toml",
        "workspaceContains:**/lore.toml"
    ],
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run bundle",
        "bundle": "esbuild src/extension.js --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --minify",
        "watch": "esbuild src/extension.js --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "esbuild": "^0.28.0"
    },
    "contributes": {
        "languages": [
            {
                "id": "lore-state",
                "aliases": [
                    "Lore State"
                ]
            }
        ],
        "grammars": [
            {
                "language": "lore-state",
                "scopeName": "source.lore-state",
                "path": "./syntaxes/lore-state.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "lore.toggleHoverStateDirectives",
                "title": "Lore: Toggle Hover State Directives",
                "category": "Lore"
            }
        ],
        "configuration": {
            "title": "Lore",
            "properties": {
                "lore.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the lore binary. If empty, uses 'lore' from PATH."
                },
                "lore.hover.stateMode": {
                    "type": "string",
                    "enum": [
                        "both",
                        "atCursor",
                        "latest"
                    ],
                    "enumDescriptions": [
                        "Show the state at the cursor and the latest state when they differ.",
                        "Show only the state resolved up to the cursor position.",
                        "Show only the latest resolved state for the entity."
                    ],
                    "default": "both",
                    "description": "Which entity state blocks to show in the hover view."
                },
                "lore.hover.showStateDirectives": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show inline state directives (+tag, field = 100) inside description prose in the hover view. Disabled by default since the resolved state is already shown at the top."
                },
                "lore.definitionStyle": {
                    "type": "string",
                    "enum": [
                        "background",
                        "underline",
                        "none"
                    ],
                    "enumDescriptions": [
                        "Tint the definition span with a faded version of the palette colour.",
                        "Underline the definition span in the palette colour.",
                        "Do not visually distinguish definition spans from prose."
                    ],
                    "default": "background",
                    "description": "How to highlight the definition occurrence of an entity name (the name on its header line or inline aside) so it stands out from references in prose."
                },
                "lore.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace communication between VSCode and the lore language server."
                }
            }
        },
        "semanticTokenTypes": [
            {
                "id": "loreEntity",
                "description": "A lore entity reference"
            }
        ],
        "semanticTokenModifiers": [
            {
                "id": "loreColourA",
                "description": "Entity colour A"
            },
            {
                "id": "loreColourB",
                "description": "Entity colour B"
            },
            {
                "id": "loreColourC",
                "description": "Entity colour C"
            },
            {
                "id": "loreColourD",
                "description": "Entity colour D"
            },
            {
                "id": "loreColourE",
                "description": "Entity colour E"
            },
            {
                "id": "loreColourF",
                "description": "Entity colour F"
            },
            {
                "id": "loreColourG",
                "description": "Entity colour G"
            },
            {
                "id": "loreColourH",
                "description": "Entity colour H"
            },
            {
